include LICENSE README.md README.en.md SECURITY.md CONTRIBUTING.md CHANGELOG.md
recursive-include src/local_mail_agent *.py *.m *.html *.toml
recursive-include tests *.py *.m
recursive-include docs *.md
recursive-include examples *.toml
recursive-include scripts *.py
prune private
prune data
prune archive
prune .venv
global-exclude *.pyc *.session* *.sqlite* *.eml *.mbox *.log .DS_Store
